enum Role {
  SUPERADMIN
  STORE_OWNER
  STORE_MANAGER
  CUSTOMER
}

enum Title {
  MR
  MS
  MRS
  MISS
  MASTER
  MADAM
}

enum Gender {
  MALE
  FEMALE
  RATHER_NOT_SAY
}
